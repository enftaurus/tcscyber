# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env

# ── Docker ────────────────────────────────────────────────────────────────────
# Keep Dockerfile and docker-compose.yml tracked; ignore runtime artefacts
docker-compose.override.yml

# ── Generated sample PE files (rebuilt at container build time) ───────────────
backend/samples/*.exe
backend/samples/*.dll
backend/samples/*.bin
backend/samples/*.com

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# ── Logs & temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
